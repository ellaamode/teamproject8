{"key":"fscma:16","no":"16","label":"제16조","title":"업무의 추가 및 인가의 변경","chapter":"제1장 금융투자업의 인가 및 등록","is_deleted":false,"law_slug":"fscma","law_name":"자본시장과 금융투자업에 관한 법률","law_kind":"법률","law_parent":null,"current":{"effective_from":"2026-10-02","effective_to":null,"title":"업무의 추가 및 인가의 변경","body":"제16조(업무의 추가 및 인가의 변경) ① 금융투자업자는 제12조에 따라 인가받은 인가업무 단위 외에 다른 인가업무 단위를 추가하여 금융투자업을 영위하려는 경우에는 제12조 및 제13조에 따라 금융위원회의 변경인가를 받아야 한다. 이 경우 제14조를 적용한다. <개정 2008.2.29, 2009.2.3>\n② 제1항에 따른 변경인가를 함에 있어서 제12조제2항제6호의 인가요건에 관하여는 같은 호에도 불구하고 대통령령으로 정하는 완화된 요건을 적용한다. <신설 2010.3.12>"},"pending":null,"history":[{"effective_from":"2026-10-02","effective_to":null}],"delegates_to":[{"key":"fscma-ed:19의2","label":"제19조의2","title":"변경인가요건의 완화","law_name":"자본시장과 금융투자업에 관한 법률 시행령","law_kind":"시행령","origin":"thdcmp"}],"delegated_from":[],"stats":{"total":4,"interp":3,"noaction":1,"guidance":0,"notice":0,"latest_on":"2019-12-30"},"documents":[{"id":"fsc.lawreq:2727","kind":"법령해석","title":"「자본시장법」 제12조, 동법 시행령 제16조, 「금융투자업규정」 제2-6조 및 <별표2>에서 정한 “위험관리전문인력”의 인정 여부","org":"금융위원회","dept":"자산운용과","published_on":"2019-12-30","stage":null,"valid_from":null,"valid_to":null,"confidence":0.55,"evidence":["제16조 제5항 제1호"],"paragraphs":[5]},{"id":"fsc.lawreq:2585","kind":"법령해석","title":"일반사무관리회사의 전산설비 임대로 인해 등록요건에 흠결이 발생하는지 여부에 관한 법령해석 신청의 건","org":"금융위원회","dept":"자산운용과","published_on":"2019-09-17","stage":null,"valid_from":null,"valid_to":null,"confidence":0.55,"evidence":["제16조"],"paragraphs":null},{"id":"fsc.lawreq:1865","kind":"법령해석","title":"일임형ISA 투자자 사전통지 방식 관련 질의","org":"금융위원회","dept":"자산운용과","published_on":"2017-11-29","stage":null,"valid_from":null,"valid_to":null,"confidence":0.55,"evidence":["제16조제1항"],"paragraphs":[1]},{"id":"fsc.pastreq:320","kind":"비조치의견","title":"토지신탁회사 인허가 등 관련 질의","org":"금융위원회","dept":null,"published_on":"2014-12-31","stage":null,"valid_from":null,"valid_to":null,"confidence":0.92,"evidence":["제16조"],"paragraphs":null}],"events":[{"occurred_on":"2019-12-30","kind":"해석_신규","ti