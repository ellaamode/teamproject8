{"key":"fscma:67","no":"67","label":"제67조","title":"자기계약의 금지","chapter":"제4장 영업행위 규칙","is_deleted":false,"law_slug":"fscma","law_name":"자본시장과 금융투자업에 관한 법률","law_kind":"법률","law_parent":null,"current":{"effective_from":"2026-10-02","effective_to":null,"title":"자기계약의 금지","body":"제67조(자기계약의 금지) 투자매매업자 또는 투자중개업자는 금융투자상품에 관한 같은 매매에 있어 자신이 본인이 됨과 동시에 상대방의 투자중개업자가 되어서는 아니 된다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 그러하지 아니하다. <개정 2013.5.28>\n1. 투자매매업자 또는 투자중개업자가 증권시장 또는 파생상품시장을 통하여 매매가 이루어지도록 한 경우\n2. 그 밖에 투자자 보호 및 건전한 거래질서를 해할 우려가 없는 경우로서 대통령령으로 정하는 경우"},"pending":null,"history":[{"effective_from":"2026-10-02","effective_to":null}],"delegates_to":[{"key":"fscma-ed:66","label":"제66조","title":"자기계약의 금지의 예외","law_name":"자본시장과 금융투자업에 관한 법률 시행령","law_kind":"시행령","origin":"thdcmp"}],"delegated_from":[],"stats":{"total":9,"interp":5,"noaction":4,"guidance":0,"notice":0,"latest_on":"2016-06-22"},"documents":[{"id":"fsc.lawreq:899","kind":"법령해석","title":"집합투자증권의 인수 업무","org":"금융위원회","dept":"자본시장과","published_on":"2016-06-22","stage":null,"valid_from":null,"valid_to":null,"confidence":0.93,"evidence":["자본시장법 제67조"],"paragraphs":null},{"id":"fsc.lawreq:875","kind":"법령해석","title":"거래소 회원의 EFP 거래당사자 지위취득","org":"금융위원회","dept":"자본시장과","published_on":"2016-04-19","stage":null,"valid_from":null,"valid_to":null,"confidence":0.92,"evidence":["자본시장법 제67조"],"paragraphs":null},{"id":"fsc.lawreq:638","kind":"법령해석","title":"인수 은행채 랩 편입 관련","org":"금융위원회","dept":"자산운용과","published_on":"2015-12-29","stage":null,"valid_from":null,"valid_to":null,"confidence":0.92,"evidence":["자본시장법 제67조"],"paragraphs":null},{"id":"fsc.lawreq:680","kind":"법령해석","title":"투자중개업자의 수익증권 매도와 자본시장법 제67조(자기계약의 금지)","org":"금융위원회","dept":"자본시장과","published_on":"2015-12-01","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["「자본시장과 금융투자업에 관한 법률」 제67조"],"paragraphs":null},{"id":"fsc.lawreq:347","kind":"법령해석","title":"기업금융부서에서 주선한 사모채권에 대해 고유자산운용부서의 투자가 가능한지","org":"금융위원회","dept":"자산운용과","published_on":"2015-05-2