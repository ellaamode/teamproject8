{"key":"fscma:54","no":"54","label":"제54조","title":"직무관련 정보의 이용 금지","chapter":"제4장 영업행위 규칙","is_deleted":false,"law_slug":"fscma","law_name":"자본시장과 금융투자업에 관한 법률","law_kind":"법률","law_parent":null,"current":{"effective_from":"2026-10-02","effective_to":null,"title":"직무관련 정보의 이용 금지","body":"제54조(직무관련 정보의 이용 금지) ① 금융투자업자는 직무상 알게 된 정보로서 외부에 공개되지 아니한 정보를 정당한 사유 없이 자기 또는 제삼자의 이익을 위하여 이용하여서는 아니 된다. <개정 2020.5.19>\n② 금융투자업자 및 그 임직원은 제45조제1항 또는 제2항에 따라 정보교류 차단의 대상이 되는 정보를 정당한 사유 없이 본인이 이용하거나 제삼자에게 이용하게 하여서는 아니 된다. <신설 2020.5.19>"},"pending":null,"history":[{"effective_from":"2026-10-02","effective_to":null}],"delegates_to":[],"delegated_from":[],"stats":{"total":3,"interp":3,"noaction":0,"guidance":0,"notice":0,"latest_on":"2016-08-25"},"documents":[{"id":"fsc.lawreq:919","kind":"법령해석","title":"비상장주식 신탁에 대한 증권회사 임직원 투자 가능 여부","org":"금융위원회","dept":"자본시장과","published_on":"2016-08-25","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["「자본시장과 금융투자업에 관한 법률」 제54조"],"paragraphs":null},{"id":"fsc.lawreq:518","kind":"법령해석","title":"자본시장법의 임직원 금융투자상품 매매와 금융실명법의 관계 해석","org":"금융위원회","dept":"은행과","published_on":"2015-08-13","stage":null,"valid_from":null,"valid_to":null,"confidence":0.88,"evidence":["같은 법 제54조"],"paragraphs":null},{"id":"fsc.lawreq:347","kind":"법령해석","title":"기업금융부서에서 주선한 사모채권에 대해 고유자산운용부서의 투자가 가능한지","org":"금융위원회","dept":"자산운용과","published_on":"2015-05-27","stage":null,"valid_from":null,"valid_to":null,"confidence":0.92,"evidence":["자본시장법 제54조"],"paragraphs":null}],"events":[{"occurred_on":"2016-08-25","kind":"해석_신규","title":"비상장주식 신탁에 대한 증권회사 임직원 투자 가능 여부","doc_id":"fsc.lawreq:919"},{"occurred_on":"2015-08-13","kind":"해석_신규","title":"자본시장법의 임직원 금융투자상품 매매와 금융실명법의 관계 해석","doc_id":"fsc.lawreq:518"},{"occurred_on":"2015-05-27","kind":"해석_신규","title":"기업금융부서에서 주선한 사모채권에 대해 고유자산운용부서의 투자가 가능한지","doc_id":"fsc.lawreq:347"}],"neighbors":[{"key":"fscma:53","label":"제53조","title":"검사 및 조치"},{"key":"fscma:55","label":"제55조","title":"손실보전 등의 금지"}]}