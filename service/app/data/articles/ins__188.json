{"key":"ins:188","no":"188","label":"제188조","title":"손해사정사 등의 업무","chapter":"제11장 보험 관계 단체 등 <개정 2010.7.23>","is_deleted":false,"law_slug":"ins","law_name":"보험업법","law_kind":"법률","law_parent":null,"current":{"effective_from":"2025-01-31","effective_to":null,"title":"손해사정사 등의 업무","body":"제188조(손해사정사 등의 업무) 손해사정사 또는 손해사정업자의 업무는 다음 각 호와 같다.\n1. 손해 발생 사실의 확인\n2. 보험약관 및 관계 법규 적용의 적정성 판단\n3. 손해액 및 보험금의 사정\n4. 제1호부터 제3호까지의 업무와 관련된 서류의 작성ㆍ제출의 대행\n5. 제1호부터 제3호까지의 업무 수행과 관련된 보험회사에 대한 의견의 진술"},"pending":null,"history":[{"effective_from":"2025-01-31","effective_to":null}],"delegates_to":[{"key":"ins-reg:9-18","label":"제9-18조","title":"손해사정사의 의무","law_name":"보험업감독규정","law_kind":"감독규정","origin":"text"}],"delegated_from":[],"stats":{"total":10,"interp":1,"noaction":9,"guidance":0,"notice":0,"latest_on":"2023-06-02"},"documents":[{"id":"fsc.lawreq:4186","kind":"법령해석","title":"손해사정 관련 문의","org":"금융위원회","dept":"보험과","published_on":"2023-06-02","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["「보험업법」 제188조"],"paragraphs":null},{"id":"fsc.pastreq:1244","kind":"비조치의견","title":"손해사정사의 손해사정 범위 관련 질의","org":"금융위원회","dept":null,"published_on":"2014-12-31","stage":null,"valid_from":null,"valid_to":null,"confidence":0.72,"evidence":["188조"],"paragraphs":null},{"id":"fsc.pastreq:1492","kind":"비조치의견","title":"손해사정사의손해사정업무에대하여","org":"금융위원회","dept":null,"published_on":"2014-12-31","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["보험업법 제188조 제3호"],"paragraphs":null},{"id":"fsc.pastreq:1617","kind":"비조치의견","title":"보험법","org":"금융위원회","dept":null,"published_on":"2014-12-31","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["보험업법 제188조"],"paragraphs":null},{"id":"fsc.pastreq:734","kind":"비조치의견","title":"손해사정 업무범위 관련 질의","org":"금융위원회","dept":null,"published_on":"2014-12-31","stage":null,"valid_from":null,"valid_to":null,"confidence":0.98,"evidence":["보험업법 제188조제2호"],"paragraphs":null},{"id":"fsc.pastreq:757","kind":"비조