# 이 파일을 .env 로 복사해 로컬에서만 쓰세요. .env 는 절대 GitHub 에 올리지 않습니다.
# Supabase > Connect > Session pooler 주소. 계정은 002_roles.sql 에서 만든 전용 계정을 씁니다.
#   배치(쓰기): batch_writer   API(읽기): api_reader
DATABASE_URL=postgresql://batch_writer.PROJECTREF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# API 가 허용할 화면 주소 (Vercel 주소, 끝에 / 없이, 여러 개면 쉼표)
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:8765

# 국가법령정보 공동활용 Open API 인증키(OC). 비워 두면 법령 수집은 건너뜀
LAW_GO_KR_OC=

# 원천 서버에 남길 연락처 (User-Agent 에 들어감)
CRAWLER_CONTACT=team8@example.com

# 첫 적재 때 하루에 받을 포털 회신 최대 건수 (0 = 제한 없음)
BACKFILL_LIMIT=1500
