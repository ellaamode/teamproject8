{"key":"fscma:52","no":"52","label":"제52조","title":"투자권유대행인의 금지행위 등","chapter":"제4장 영업행위 규칙","is_deleted":false,"law_slug":"fscma","law_name":"자본시장과 금융투자업에 관한 법률","law_kind":"법률","law_parent":null,"current":{"effective_from":"2026-10-02","effective_to":null,"title":"투자권유대행인의 금지행위 등","body":"제52조(투자권유대행인의 금지행위 등) ① 금융투자업자는 투자권유대행인 외의 자에게 투자권유를 대행하게 하여서는 아니 된다.\n② 삭제 <2020.3.24>\n③ 삭제 <2020.3.24>\n④ 금융투자업자는 투자권유대행인이 투자권유를 대행함에 있어서 법령을 준수하고 건전한 거래질서를 해하는 일이 없도록 성실히 관리하여야 하며, 이를 위한 투자권유대행기준을 정하여야 한다.\n⑤ 삭제 <2020.3.24>\n⑥ 제48조, 제54조, 제55조 및 「금융실명거래 및 비밀보장에 관한 법률」 제4조는 투자권유대행인이 투자권유를 대행하는 경우에 준용한다. <개정 2020.3.24>"},"pending":null,"history":[{"effective_from":"2026-10-02","effective_to":null}],"delegates_to":[],"delegated_from":[],"stats":{"total":4,"interp":3,"noaction":1,"guidance":0,"notice":0,"latest_on":"2021-07-29"},"documents":[{"id":"fsc.lawreq:3498","kind":"법령해석","title":"부동산신탁상품 단순소개 업무위수탁계약 체결관련","org":"금융위원회","dept":"자산운용과","published_on":"2021-07-29","stage":null,"valid_from":null,"valid_to":null,"confidence":0.93,"evidence":["제52조"],"paragraphs":null},{"id":"fsc.lawreq:1359","kind":"법령해석","title":"농협은행이  농축협과 \"부동산담보신탁 소개업무\"에 대한 업무위수탁 계약을 체결할 수 있는지 여부","org":"금융위원회","dept":"자산운용과","published_on":"2017-01-09","stage":null,"valid_from":null,"valid_to":null,"confidence":0.93,"evidence":["자본시장법 제52조"],"paragraphs":null},{"id":"fsc.opinion:695","kind":"비조치의견","title":"금융투자회사의 영업 및 업무에 관한 규정 2-8조의2,\n불완전판매 제재사실 공시의무","org":"금융위원회","dept":"자본시장과","published_on":"2016-02-01","stage":null,"valid_from":null,"valid_to":null,"confidence":0.78,"evidence":["제52조"],"paragraphs":null},{"id":"fsc.lawreq:406","kind":"법령해석","title":"투자권유 업무위수탁","org":"금융위원회","dept":"자본시장과","published_on":"2015-08-28","stage":null,"valid_from":null,"valid_to":null,"confidence":0.93,"evidence":["자본시장법 제52조제1항"],"paragraphs":[1]}],"events":[{"occurred_on":"2021-07-29","kind":"해석_신규","title":"부동산신탁상품 단순소개 업무위수탁계약 체결관련","doc_id":"fsc.lawreq:3498"},{"occurred_on":"2017-01-09","kind":"해석_신규","title":